<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NoWarn>$(NoWarn);CA1873</NoWarn>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>Neph.GenericLibs.Net.HangFireLib</PackageId>
		<Version>0.1.0</Version>
		<Authors>Neph</Authors>
		<Description>Generic Hangfire helpers and service registration extensions for ASP.NET Core applications.</Description>
		<PackageProjectUrl>https://github.com/NephChevsky/GenericLibs.Net</PackageProjectUrl>
		<RepositoryUrl>https://github.com/NephChevsky/GenericLibs.Net</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>hangfire;jobs;dotnet;neph;genericlibs.net</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Hangfire.AspNetCore" Version="1.8.25" />
		<PackageReference Include="Hangfire.MemoryStorage" Version="1.8.1.2" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	</ItemGroup>

</Project>
