<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>Neph.GenericLibs.Net.LLMLib</PackageId>
		<Version>0.2.0</Version>
		<Authors>Neph</Authors>
		<Description>Generic LLM chat abstractions (service interface, DTOs and a reusable ASP.NET Core chatbot controller) independent of the underlying provider.</Description>
		<PackageProjectUrl>https://github.com/NephChevsky/GenericLibs.Net</PackageProjectUrl>
		<RepositoryUrl>https://github.com/NephChevsky/GenericLibs.Net</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>llm;ai;chatbot;dotnet;neph;genericlibs.net</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.2.0" />
	</ItemGroup>

</Project>
