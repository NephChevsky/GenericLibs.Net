<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Neph.GenericLibs.Net.DatabaseLib</PackageId>
    <Version>0.1.0</Version>
    <Authors>Neph</Authors>
    <Description>Provider-agnostic database abstractions for EF Core (generic DbContext, tracking interfaces, provider abstraction and registration).</Description>
    <PackageProjectUrl>https://github.com/NephChevsky/GenericLibs.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NephChevsky/GenericLibs.Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>database;efcore;entityframework;dotnet;neph;genericlibs.net</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Http" Version="2.3.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.12" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>

</Project>
