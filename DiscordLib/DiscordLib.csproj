<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NoWarn>$(NoWarn);CA1873</NoWarn>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>Neph.GenericLibs.Net.DiscordLib</PackageId>
		<Version>0.1.0</Version>
		<Authors>Neph</Authors>
		<Description>Generic Discord client helpers and service registration extensions for ASP.NET Core applications.</Description>
		<PackageProjectUrl>https://github.com/NephChevsky/GenericLibs.Net</PackageProjectUrl>
		<RepositoryUrl>https://github.com/NephChevsky/GenericLibs.Net</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>discord;bot;dotnet;neph;genericlibs.net</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.3" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.3" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.3" />
		<PackageReference Include="Neph.GenericLibs.Net.NotifierLib" Version="0.1.0" />
	</ItemGroup>

</Project>
