<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NoWarn>$(NoWarn);CA1873</NoWarn>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>Neph.GenericLibs.Net.JwtLib</PackageId>
		<Version>0.4.0</Version>
		<Authors>Neph</Authors>
		<Description>Generic JWT authentication helpers, controllers and service registration extensions for ASP.NET Core applications.</Description>
		<PackageProjectUrl>https://github.com/NephChevsky/GenericLibs.Net</PackageProjectUrl>
		<RepositoryUrl>https://github.com/NephChevsky/GenericLibs.Net</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>jwt;auth;authentication;dotnet;neph;genericlibs.net</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="BCrypt.Net-Next" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
		<PackageReference Include="Neph.GenericLibs.Net.NotifierLib" />
		<PackageReference Include="Neph.GenericLibs.Net.DatabaseLib" />
		<PackageReference Include="Neph.GenericLibs.Net.JwtLib.Contracts" />
	</ItemGroup>

</Project>
