<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Neph.GenericLibs.Net.AzureSqlLib</PackageId>
    <Version>0.1.0</Version>
    <Authors>Neph</Authors>
    <Description>Azure SQL / SQL Server provider for DatabaseLib: EF Core registration and design-time factory for ASP.NET Core applications.</Description>
    <PackageProjectUrl>https://github.com/NephChevsky/GenericLibs.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NephChevsky/GenericLibs.Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>azure;sql;sqlserver;efcore;entityframework;dotnet;neph;genericlibs.net</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Neph.GenericLibs.Net.DatabaseLib" Version="0.1.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.3" />
  </ItemGroup>

</Project>
