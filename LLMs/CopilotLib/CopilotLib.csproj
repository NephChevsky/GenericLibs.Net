<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);GHCP001</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Neph.GenericLibs.Net.CopilotLib</PackageId>
    <Version>0.6.0</Version>
    <Authors>Neph</Authors>
    <Description>GitHub Copilot SDK wrapper with a service, DI registration and a reusable ASP.NET Core chatbot controller.</Description>
    <PackageProjectUrl>https://github.com/NephChevsky/GenericLibs.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NephChevsky/GenericLibs.Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>copilot;github-copilot;chatbot;dotnet;neph;genericlibs.net</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <InternalsVisibleTo Include="CopilotLib.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GitHub.Copilot.SDK" />
    <PackageReference Include="Neph.GenericLibs.Net.LLMLib" />
  </ItemGroup>

  <ItemGroup>
    <None Include="buildTransitive\Neph.GenericLibs.Net.CopilotLib.targets" Pack="true" PackagePath="buildTransitive\;build\" />
  </ItemGroup>

  <PropertyGroup>
    <BeforePack>$(BeforePack);_GenerateCopilotSdkVersionFile</BeforePack>
  </PropertyGroup>

  <!-- Records the resolved GitHub.Copilot.SDK version so the packed targets import the matching SDK runtime targets. -->
  <Target Name="_GenerateCopilotSdkVersionFile" DependsOnTargets="ResolvePackageAssets">
    <ItemGroup>
      <_CopilotSdkAsset Include="@(ResolvedCompileFileDefinitions)" Condition="'%(ResolvedCompileFileDefinitions.NuGetPackageId)' == 'GitHub.Copilot.SDK'" />
    </ItemGroup>
    <PropertyGroup>
      <_CopilotSdkVersion>@(_CopilotSdkAsset->'%(NuGetPackageVersion)'->Distinct())</_CopilotSdkVersion>
      <_CopilotSdkVersionFile>$(IntermediateOutputPath)Neph.GenericLibs.Net.CopilotLib.SdkVersion.targets</_CopilotSdkVersionFile>
    </PropertyGroup>
    <Error Condition="'$(_CopilotSdkVersion)' == '' Or $(_CopilotSdkVersion.Contains(';'))" Text="Could not determine a single resolved GitHub.Copilot.SDK version (found '$(_CopilotSdkVersion)')." />
    <ItemGroup>
      <_CopilotSdkVersionFileLine Include="&lt;Project&gt;" />
      <_CopilotSdkVersionFileLine Include="  &lt;PropertyGroup&gt;" />
      <_CopilotSdkVersionFileLine Include="    &lt;NephCopilotLibSdkVersion&gt;$(_CopilotSdkVersion.ToLowerInvariant())&lt;/NephCopilotLibSdkVersion&gt;" />
      <_CopilotSdkVersionFileLine Include="  &lt;/PropertyGroup&gt;" />
      <_CopilotSdkVersionFileLine Include="&lt;/Project&gt;" />
    </ItemGroup>
    <WriteLinesToFile File="$(_CopilotSdkVersionFile)" Lines="@(_CopilotSdkVersionFileLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <None Include="$(_CopilotSdkVersionFile)" Pack="true" PackagePath="buildTransitive\;build\" />
      <FileWrites Include="$(_CopilotSdkVersionFile)" />
    </ItemGroup>
  </Target>

</Project>
