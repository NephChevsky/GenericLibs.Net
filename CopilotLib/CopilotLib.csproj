<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);GHCP001</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Neph.GenericLibs.Net.CopilotLib</PackageId>
    <Version>0.1.5</Version>
    <Authors>Neph</Authors>
    <Description>GitHub Copilot SDK wrapper with a service, DI registration and a reusable ASP.NET Core chatbot controller.</Description>
    <PackageProjectUrl>https://github.com/NephChevsky/GenericLibs.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NephChevsky/GenericLibs.Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>copilot;github-copilot;chatbot;dotnet;neph;genericlibs.net</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GitHub.Copilot.SDK" Version="1.0.22" />
  </ItemGroup>

  <ItemGroup>
    <None Include="buildTransitive\Neph.GenericLibs.Net.CopilotLib.targets" Pack="true" PackagePath="buildTransitive\" />
    <None Include="buildTransitive\Neph.GenericLibs.Net.CopilotLib.targets" Pack="true" PackagePath="build\" />
  </ItemGroup>

</Project>
